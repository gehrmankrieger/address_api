    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Reports ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Create address (Makati)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"Returns an id\", () => pm.expect(body.id).to.be.a(\"number\"));",
              "pm.test(\"Trims whitespace in label\", () => pm.expect(body.label).to.eql(\"Office\"));",
              "pm.test(\"Has timestamps\", () => { pm.expect(body.created_at).to.be.a(\"string\"); pm.expect(body.updated_at).to.be.a(\"string\"); });",
              "pm.collectionVariables.set(\"addressId\", body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/addresses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "addresses"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"label\": \"  Office  \",\n  \"street\": \"Ayala Ave\",\n  \"city\": \"Makati\",\n  \"postal_code\": \"1226\",\n  \"country\": \"Philippines\",\n  \"latitude\": 14.5547,\n  \"longitude\": 121.0244\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
