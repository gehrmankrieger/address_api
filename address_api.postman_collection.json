    {
      "name": "Nearby: 10 km around Rizal Park",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
              "const results = pm.response.json();",
              "const ids = results.map(a => a.id);",
              "pm.test(\"Includes Makati (~5.8 km)\", () => pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"addressId\"))));",
              "pm.test(\"Excludes Cebu (~570 km)\", () => pm.expect(ids).to.not.include(Number(pm.collectionVariables.get(\"farAddressId\"))));",
              "pm.test(\"Every result is within 10 km\", () => results.forEach(a => pm.expect(a.distance_km).to.be.at.most(10)));",
              "pm.test(\"Sorted nearest first\", () => { for (let i = 1; i < results.length; i++) pm.expect(results[i].distance_km).to.be.at.least(results[i - 1].distance_km); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/addresses/nearby?latitude=14.5831&longitude=120.9794&distance_km=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "addresses",
            "nearby"
          ],
          "query": [
